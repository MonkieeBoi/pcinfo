<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="icon" href="/assets/favicon.ico" />
    <script>
        try {
            if (localStorage.getItem("mirror") === "on")
                document.documentElement.dataset.mirror = "on";
        } catch (e) { }
    </script>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body {% if noSearch or sub.section == '1' %}data-rangefind-ignore{% endif %}>
    <nav>
        <a href="/">
            <img id="logo" src="/assets/favicon.ico">
        </a>
        <button id="search-toggle" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </button>
        <button id="mirror-toggle" type="button">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v2M12 8v2M12 14v2M12 20v2"/>
                <path d="m3 7 5 5-5 5V7" fill="currentColor"/>
                <path d="m21 7-5 5 5 5V7"/>
            </svg>
        </button>
    </nav>


    <div class="rf-backdrop hidden"
        style="display: flex; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); position: fixed; z-index: 1000; align-items: flex-start; justify-content: center; padding-top: 20vh;">
        {% rangefindSearch {
        theme: true,
        highlight: true,
        suggest: false
        } %}
    </div>

    <div class="content">
        {{ content | safe }}
    </div>

    <audio id="woop" src="/assets/audio/woop.mp3" preload="auto"></audio>
    <audio id="whoosh" src="/assets/audio/whoosh.mp3" preload="auto"></audio>
    <script src="/js/tree.js"></script>
    <script src="/js/mirror.js"></script>
    <script src="/js/search.js"></script>
</body>

</html>
