<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="icon" href="/assets/favicon.ico" />
    <script>
        try {
            if (localStorage.getItem("mirror") === "on")
                document.documentElement.dataset.mirror = "on";
        } catch (e) { }
    </script>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body>
    <header>
        <a href="/">
            <img id="logo" src="/assets/favicon.ico">
        </a>
        <button id="mirror-toggle" type="button">Mirror</button>
    </header>

    <div class="content">
        {{ content | safe }}
    </div>

    <script src="/js/tree.js"></script>
    <script src="/js/mirror.js"></script>
</body>

</html>
