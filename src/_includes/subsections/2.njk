---
layout: base.njk
---
<h1 class="hidden" data-rangefind-body data-rangefind-meta="title">{% normal_label sub.title %} 2nd</h1>
<h1>{% label sub.title %} 2nd</h1>

<div class="scroll-x">
    <table>
        {% for e in entries | withTag("1min") %}
            {% if e.section == sub.section and e.subsection == sub.slug %}
                <tr>
                    <th><h3>{% label e.title %}</h3></th>
                    {% if e.setup %}
                        <th>{% fumen e.setup, {page: 1} %}</th>
                        <th>{% fumen e.setup, {page: 2} %}</th>
                        <th>{% fumen e.setup, {page: 3} %}</th>
                    {% endif %}
                </tr>
            {% endif %}
        {% endfor %}
    </table>
</div>
<br>

{% set matches = [] %}
{% for e in entries | withTag("normal") %}
    {% if e.section == sub.section and e.subsection == sub.slug %}
        {% set _ = matches.push(e) %}
    {% endif %}
{% endfor %}


<div class="entry-grid">
{% for title, items in matches | groupby("title") %}
    <section class="entry-card">
        <h2>{% label title %}</h2>
        {% for e in items %}
            {% if e.setup %}
            <div>{% fumen e.setup %}</div>
            {% endif %}
            {% if e.solves %}
              <details>
                  <summary>Solves ({{ e.solves | fumenPages | length }})</summary>
                {% for p in e.solves | fumenPages %}
                  {% fumen e.solves, {page: p} %}
                {% endfor %}
              </details>
            {% endif %}
        {% endfor %}
    </section>
{% endfor %}
</div>

{% for e in entries | withTag("oqb") %}
    {% if e.section == sub.section and e.subsection == sub.slug %}
        <hr>
        <h2>{% label e.title %}</h2>
        {% for t in e.trees %}
            <div class="scroll-x">
                {% tree t %}
            </div>
        {% endfor %}
    {% endif %}
{% endfor %}
